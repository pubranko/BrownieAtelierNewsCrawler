                    <mxGeometry x="140" y="970" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="候補の urls を選んだ目印に置き換えて返す&#xa;→ 全体図⑥で保存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
