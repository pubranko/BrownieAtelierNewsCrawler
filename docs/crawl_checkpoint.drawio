                    <mxGeometry x="60" y="180" width="500" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="valid" value="全記事の日時が分かる？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="140" y="310" width="340" height="100" as="geometry"/>
