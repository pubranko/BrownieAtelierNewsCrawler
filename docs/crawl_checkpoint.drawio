                    <mxGeometry x="140" y="465" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="boundary" value="未完了記事の最も古い日時を境界にする&#xa;境界より前の対象記事から、最大の日時を選ぶ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
