            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="4  URL 方式：「成功した最新 10 件」ではなく、安全な目印を選ぶ" style="text;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontSize=22;fontFamily=Noto Sans CJK JP;spacing=10;align=left;fontStyle=1;" parent="1" vertex="1">
