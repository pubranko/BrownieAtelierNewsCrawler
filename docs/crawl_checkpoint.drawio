                </mxCell>
                <mxCell id="forward" value="選べる日時があり、&#xa;前回日時より進められる？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="130" y="930" width="360" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="selected" value="候補の latest_lastmod をその日時に変更して返す&#xa;→ 全体図⑥で保存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1135" width="500" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="old" value="前回位置を返す&#xa;→ 全体図⑥で同じ位置を保存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="940" y="950" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="all" value="全件完了：今回の候補をそのまま返す&#xa;→ 全体図⑥で保存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="690" y="485" width="460" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="example" value="例：前回位置は 09:55&#xa;&#xa;10:00  保存成功  ← 今回保存する位置&#xa;10:05  保存失敗  ← 未完了の境界&#xa;10:10  保存成功  ← 先へ進む根拠にしない&#xa;&#xa;次回は 10:05 を再取得できる。&#xa;10:10 の再取得は許容する。&#xa;現行の継続判定は「保存日時より古い記事」を&#xa;スキップするため、10:00 も再取得対象になる。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
