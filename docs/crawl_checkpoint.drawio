                </mxCell>
                <mxCell id="old" value="前回位置を返す&#xa;複数起点／urls なし／位置不明／目印不足&#xa;→ 全体図⑥で同じ位置を保存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
