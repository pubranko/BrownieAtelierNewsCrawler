                    <mxGeometry x="140" y="335" width="340" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="where" value="未完了の記事すべての位置が分かる？&#xa;最も古い未完了記事を探す" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
