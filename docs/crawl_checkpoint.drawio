    <diagram id="lastmod" name="3 lastmod 方式">
        <mxGraphModel dx="1422" dy="764" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1300" math="0" shadow="0">
