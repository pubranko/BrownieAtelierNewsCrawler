                </mxCell>
                <mxCell id="subtitle" value="前提：2 ページ目で記事発見が完了している。対象記事は保存結果で判定し、同じ lastmod の記事は一組として扱う。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=Noto Sans CJK JP;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="75" width="1140" height="65" as="geometry"/>
