# 第1段階: OS・Python・ブラウザーの依存と、アプリの初期インストールを行う。
# 通常のソース・Python ライブラリー更新は、このイメージを再利用して dockerfile で行う。
# OS/Python/uv の更新、OS のセキュリティー更新、追加の OS 依存が必要な場合は、
# このベースを再ビルドして BASE_TAG を更新し、続いてアプリ側もビルドする。
# CI はベース定義のハッシュもキャッシュキーに含めるため、このファイルの変更で再構築する。
# Ubuntu 26.04 と Python 3.14 を使う、ニュースクローラー用のベースイメージ
# `UBUNTU_TAG` を変えることで、同じ Dockerfile のまま Ubuntu の更新を可能にする。
# FROM で使う ARG は、最初の FROM より前のグローバルスコープに定義する。
ARG UBUNTU_TAG=26.04
# uv バイナリーの版。再現可能なイメージ作成のため、latest ではなく固定する。
ARG UV_VERSION=0.12.10

# COPY --from は変数展開できないため、版指定は FROM で解決してステージ名を付ける。
# このステージはバイナリー取得専用。OS とアプリを構築する従来の2段階運用は維持する。
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv_binary

FROM ubuntu:${UBUNTU_TAG}

# コンテナ内で実行する一般ユーザー名。ホスト側の bind mount と所有者を合わせるために使う。
ARG CONTAINER_USER
# イメージ作成時に clone するリモートリポジトリーとブランチ。
ARG GIT_REMOTE_REPOSITORY
ARG GIT_BRANCH

# イメージの用途を識別するメタデータ。
LABEL maintainer="BrownieAtelierNewsCrawlerBase"

# コンテナ内の日時・ログを日本時間にする。tzdata パッケージがタイムゾーン情報を提供する。
# Python が .pyc を作らないため、bind mount 配下に __pycache__ を残さない。
# Python の標準出力・標準エラー出力をバッファリングせず、Docker のログへ即座に出力する。
# uv のファイル配置をコピー方式にし、異なるファイルシステム間でのハードリンク失敗を防ぐ。
# uv が使用する Python を Ubuntu に導入する Python 3.14 に固定する。
# uv による別バージョンの Python 自動ダウンロードを禁止し、実行環境との差異を防ぐ。
# Playwright の Chromium を共通パスへ置き、派生イメージ・実行ユーザーから同じ場所を参照する。
ENV TZ=Asia/Tokyo \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=python3.14 \
    UV_PYTHON_DOWNLOADS=never \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ubuntu:26.04 は最小 OS イメージで Python を含まないため、Python 3.14 本体と venv 機能を導入する。
# ca-certificates は HTTPS 通信、git はリポジトリー取得、
# tzdata は上記 TZ 設定のために必要となる。
# Dockerfile は非対話スクリプトなので、対話用の apt ではなく apt-get を使用する。
# update と install を同じレイヤーに置き、古いパッケージ一覧が Docker キャッシュされる問題を防ぐ。
# --no-install-recommends と apt リスト削除で、不要な推奨パッケージとイメージサイズを抑える。
# Playwright の OS 依存は、下の `playwright install --with-deps` が追加で導入する。
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
        python3.14 \
        python3.14-venv \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

# pip 経由ではなく、公式コンテナイメージから固定版の uv バイナリーを導入する。
COPY --from=uv_binary /uv /uvx /bin/

# アプリの初期導入・派生イメージでの更新・コンテナ実行に使う一般ユーザーを用意する。
# Ubuntu 26.04 には ubuntu ユーザー・グループ（UID/GID 1000）があるため、
# 新規作成すると衝突する。既存 ubuntu を指定名へ変更し、ホームも移動して再利用する。
# ubuntu がないベースでは UID/GID 1000 で新規作成する。別ユーザーとの衝突はエラーにする。
# UID/GID は 1000 に固定。bind mount の所有権は名前ではなく数値で照合されるため、
# ホスト側でも保存先をこの UID/GID で書き込めるよう設定する。
# 既存 ubuntu の sudo・adm などの補助グループ所属をすべて外し、パスワードをロックする。
# Docker の USER による実行にはログインパスワードは不要。OS 管理はビルド中の root で行う。
RUN if id ubuntu >/dev/null 2>&1; then \
        test "$(id -u ubuntu)" = 1000 && test "$(id -g ubuntu)" = 1000 \
        && if [ "${CONTAINER_USER}" != ubuntu ]; then \
            groupmod --new-name "${CONTAINER_USER}" ubuntu \
            && usermod --login "${CONTAINER_USER}" --home "/home/${CONTAINER_USER}" --move-home ubuntu; \
        fi; \
    else \
        groupadd --gid 1000 "${CONTAINER_USER}" \
        && useradd --uid 1000 --create-home --gid "${CONTAINER_USER}" --shell /bin/bash "${CONTAINER_USER}"; \
    fi \
    && usermod --groups "" --lock "${CONTAINER_USER}" \
    && test "$(id -u "${CONTAINER_USER}")" = 1000 \
    && test "$(id -G "${CONTAINER_USER}")" = 1000

# clone 先の親ディレクトリーを作業ディレクトリーにし、以降は一般ユーザーとして処理する。
WORKDIR /home/${CONTAINER_USER}
USER ${CONTAINER_USER}

# イメージ作成時の Git 操作に使う仮の利用者情報を設定する。
# 指定ブランチと submodule を含めて clone し、Git の所有者チェック対象として clone 先を登録する。
RUN git config --global user.email "kari@example.com" \
    && git config --global user.name "kari Name" \
    # git clone (サブモジュールごとクローンする)
    && git clone --recursive --branch "${GIT_BRANCH}" "${GIT_REMOTE_REPOSITORY}" BrownieAtelierNewsCrawler \
    # リポジトリの所有権でエラーが出ないように例外をコンフィグに登録
    && git config --global --add safe.directory "/home/${CONTAINER_USER}/BrownieAtelierNewsCrawler"

# clone したプロジェクトを以降の uv と Playwright の実行場所にする。
WORKDIR /home/${CONTAINER_USER}/BrownieAtelierNewsCrawler

# pyproject.toml と uv.lock の不整合があれば失敗させ、ロック済みの実行時依存だけを .venv へ導入する。
# --no-dev により、コンテナ実行に不要な marimo・Ruff・Pyrefly などの開発依存を除外する。
RUN uv sync --locked --no-dev

# Playwright は OS パッケージの導入を伴うため、この処理だけ root で実行する。
# Chromium 本体と依存ライブラリーを導入し、一般ユーザーが派生イメージでブラウザー更新できるよう所有者を戻す。
USER root
RUN .venv/bin/playwright install --with-deps chromium \
    && chown --recursive "${CONTAINER_USER}:${CONTAINER_USER}" "${PLAYWRIGHT_BROWSERS_PATH}"

# クローラー実行用の一般ユーザーへ戻し、Python・uv・Chromium が利用可能かビルド時に確認する。
USER ${CONTAINER_USER}
RUN .venv/bin/python --version \
    && uv --version \
    && .venv/bin/playwright install --list

# docker-compose から bind mount する MongoDB 接続用の CA/PEM ファイルの配置先を作成する。
RUN mkdir /home/${CONTAINER_USER}/mongo-key

# ベースイメージ単体では実行コマンドを固定せず、派生イメージや docker-compose 側で指定できるようにする。
ENTRYPOINT []
CMD []
